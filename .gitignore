runs/

# ── Entornos virtuales ─────────────────────────────────
*.venv
venv/
env/

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Jupyter ────────────────────────────────────────────
.ipynb_checkpoints/

